      m_Calls: []
  m_text: "\uB354 \uC7AC\uBBF8\uC788\uB294 \uAC8C\uC784\uC744 \uB9CC\uB4E4\uAE30
    \uC704\uD574 \uD50C\uB808\uC774 \uAE30\uB85D(\uD310 \uACB0\uACFC, \uACE0\uB978
    \uC7A5\uBE44, \uC9C4\uD589 \uC0C1\uD669)\uACFC \uAE30\uBCF8 \uAE30\uAE30 \uC815\uBCF4\uB97C
    \uC775\uBA85\uC73C\uB85C \uC218\uC9D1\uD558\uB824\uACE0 \uD569\uB2C8\uB2E4.\n\uC124\uBB38\uC5D0
    \uCC38\uC5EC\uD558\uBA74 \uC124\uBB38 \uB2F5\uACFC \uD50C\uB808\uC774 \uAE30\uB85D\uC774
    \uAC19\uC740 \uC775\uBA85 \uBC88\uD638\uB85C \uBB36\uC785\uB2C8\uB2E4.\n\uC774\uB984,
    \uC5F0\uB77D\uCC98 \uAC19\uC740 \uAC1C\uC778\uC815\uBCF4\uB294 \uC218\uC9D1\uD558\uC9C0
    \uC54A\uACE0, \uC124\uC815\uC5D0\uC11C \uC5B8\uC81C\uB4E0 \uB04C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
