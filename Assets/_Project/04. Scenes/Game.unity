    - target: {fileID: 2394887624128867735, guid: 9ba37d685e416a943ba9097cd9162ded, type: 3}
      propertyPath: m_text
      value: "\uBB34\uD55C \uBAA8\uB4DC \uCD5C\uACE0 \uCC98\uCE58 \uC218\uB97C \uC804
        \uC138\uACC4 \uC21C\uC704\uD45C\uC5D0 \uC62C\uB9BD\uB2C8\uB2E4.\n\uC21C\uC704\uD45C\uC5D0\uB294
        \uC774 \uC774\uB984\uACFC \uAE30\uB85D\uB9CC \uBCF4\uC785\uB2C8\uB2E4."
