    - target: {fileID: 1274090302604690012, guid: 9ba37d685e416a943ba9097cd9162ded, type: 3}
      propertyPath: _firstBody
      value: "\uBB34\uD55C\uBAA8\uB4DC\uC758 \uCD5C\uACE0 \uAE30\uB85D\uC774 \uC804
        \uC138\uACC4 \uB9AC\uB354\uBCF4\uB4DC\uC5D0 \uAE30\uB85D\uB429\uB2C8\uB2E4.\n\uAE30\uB85D\uB420
        \uB2C9\uB124\uC784\uC744 \uC785\uB825\uD574 \uC8FC\uC2ED\uC2DC\uC624.\n\uC124\uC815\uC5D0\uC11C
        \uC5B8\uC81C\uB4E0 \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 1417893417910041518, guid: 9ba37d685e416a943ba9097cd9162ded, type: 3}
      propertyPath: m_text
      value: "\uC548 \uD568"
      objectReference: {fileID: 0}
    - target: {fileID: 1417893417910041518, guid: 9ba37d685e416a943ba9097cd9162ded, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4279905868
      objectReference: {fileID: 0}
    - target: {fileID: 1417893417910041518, guid: 9ba37d685e416a943ba9097cd9162ded, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 1695742151116339701, guid: 9ba37d685e416a943ba9097cd9162ded, type: 3}
      propertyPath: m_text
      value: "2~12\uC790\uC758 \uD55C\uAE00, \uC601\uBB38, \uC22B\uC790, \uBC11\uC904\uB9CC
        \uC4F8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 1695742151116339701, guid: 9ba37d685e416a943ba9097cd9162ded, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4281550783
      objectReference: {fileID: 0}
