      m_Items: []
  - m_Id: 1975698591747
    m_Localized: "\uC800\uC8FC\uB294 \uBB34\uD55C \uBAA8\uB4DC\uC5D0\uC11C\uB9CC
      \uC801\uC6A9\uB428."
    m_Metadata:
      m_Items: []
