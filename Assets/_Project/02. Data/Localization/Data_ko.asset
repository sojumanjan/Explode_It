    m_Metadata:
      m_Items: []
  - m_Id: 6819880636487
    m_Localized: "\uD55C \uD310\uC5D0 \uC801 500\uB9C8\uB9AC \uCC98\uCE58\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636488
    m_Localized: "\uC804\uC124\uC758 \uC0AC\uB0E5\uAFBC"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636489
    m_Localized: "\uD55C \uD310\uC5D0 \uC801 1000\uB9C8\uB9AC \uCC98\uCE58\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636490
    m_Localized: "\uB9E8\uC190 \uC0AC\uB0E5\uAFBC"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636491
    m_Localized: "\uC2A4\uD0AC\uC744 \uC4F0\uC9C0 \uC54A\uACE0 \uD55C \uD310\uC5D0
      \uC801 200\uB9C8\uB9AC \uCC98\uCE58\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636492
    m_Localized: "\uBC31\uBC1C\uBC31\uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636493
    m_Localized: "\uD3ED\uD0C4\uC744 \uD55C \uBC88\uB3C4 \uBE57\uB9DE\uD788\uC9C0
      \uC54A\uACE0\n\uD55C \uD310\uC5D0 \uC801 100\uB9C8\uB9AC \uCC98\uCE58\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636494
    m_Localized: "\uC6D0\uC0F7 \uC6D0\uD0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636495
    m_Localized: "\uD3ED\uD0C4 \uD558\uB098\uC5D0 \uD55C \uB9C8\uB9AC\uC529, 10\uBC88
      \uC5F0\uC18D\uC73C\uB85C \uCC98\uCE58\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636496
