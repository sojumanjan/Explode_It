  m_TableData:
  - m_Id: 6819830304768
    m_Localized: "\uCD1D\uACF5\uC138"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636416
    m_Localized: "\uC801\uC774 25% \uB354 \uBE68\uB9AC \uBAB0\uB824\uC624\uACE0,\n\uBAA8\uB4E0
      \uC885\uB958\uC758 \uC801\uC774 \uCC98\uC74C\uBD80\uD130 \uB4F1\uC7A5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636417
    m_Localized: "\uC720\uD3ED"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636418
    m_Localized: "\uC801\uC774 \uC8FD\uC740 \uC790\uB9AC\uC5D0\uC11C \uD3ED\uBC1C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636419
    m_Localized: "\uC6B4\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636420
    m_Localized: "5\uCD08\uB9C8\uB2E4 \uB0B4 \uADFC\uCC98\uC5D0 \uC6B4\uC11D\uC774
      \uB5A8\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636421
    m_Localized: "\uAD11\uD3ED"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636422
    m_Localized: "\uAC00\uB054 \uBD89\uAC8C \uB2EC\uC544\uC624\uB978 \uC801\uC774\n\uB9E4\uC6B0
      \uBE60\uB974\uAC8C \uB2EC\uB824\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636423
    m_Localized: "\uB099\uB8B0"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636424
    m_Localized: "18\uCD08\uB9C8\uB2E4 \uC544\uC8FC \uB113\uC740 \uACF3\uC5D0 \uBC88\uAC1C\uAC00
      \uB0B4\uB9AC\uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636425
    m_Localized: "\uAE30\uC2B5"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636426
    m_Localized: "50%\uD655\uB960\uB85C \uC801\uC774 \uD50C\uB808\uC774\uC5B4 \uADFC\uCC98\uC5D0\uC11C
      \uC2A4\uD3F0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636427
    m_Localized: "\uB36B"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636428
    m_Localized: "10\uCD08\uB9C8\uB2E4 \uB0B4 \uADFC\uCC98\uC5D0 \uB36B 3\uAC1C\uAC00
      \uAE54\uB9B0\uB2E4.\n\uBC1F\uC73C\uBA74 \uD53C\uD574\uB97C \uC785\uC9C0\uB9CC,
      \uD3ED\uD0C4\uC73C\uB85C \uC81C\uAC70\uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636429
    m_Localized: "\uD55C \uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636430
    m_Localized: "\uCCB4\uB825\uC774 1\uCE78\uC774 \uB41C\uB2E4.\n\uD32C\uB358\uD2B8\uB3C4
      \uC18C\uC6A9\uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636431
    m_Localized: "\uBA3C\uC9C0\uBC14\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636432
    m_Localized: "\uB9F5 \uACF3\uACF3\uC5D0 \uBA3C\uC9C0\uBC14\uB78C\uC774 \uBD84\uB2E4.\n\uBC14\uB78C
      \uC548\uC5D0\uC11C\uB294 \uBC1C\uC774 30% \uB290\uB824\uC9C0\uACE0, \uBC14\uB78C\uC740
      \uACC4\uC18D \uC790\uB9AC\uB97C \uC62E\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636433
    m_Localized: "\uBAA8\uB4E0 \uC800\uC8FC\uB97C \uC9CA\uC5B4\uC9C4 \uC790\uC5D0\uAC8C\n\uADF8\uBD84\uC774
      \uC9C1\uC811 \uCC3E\uC544\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636434
    m_Localized: "\uAD81\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636435
    m_Localized: "\uD654\uC5FC \uB9C8\uBC95\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636436
    m_Localized: "\uB4DC\uB9B4 \uAD11\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636437
    m_Localized: "\uC57C\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636438
    m_Localized: "\uAC01\uC131\uD55C \uC655"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636439
    m_Localized: "\uC800 \uC655\uAD00\uC774 \uB5A8\uC5B4\uC9C8 \uB54C\uB97C \uB178\uB824\uC57C
      \uD560 \uAC83 \uAC19\uC740\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636440
    m_Localized: "\uB3CC\uACA9\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636441
    m_Localized: "\uACE8\uB818"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636442
    m_Localized: "\uC0AC\uB9C8\uADC0"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636443
    m_Localized: "\uBC29\uD328\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636444
    m_Localized: "\uC800\uACA9\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636445
    m_Localized: "\uC804\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636446
    m_Localized: "\uBE14\uB799\uD640"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636447
    m_Localized: "\uB113\uC740 \uBC94\uC704\uC758 \uC801\uC744 \uD55C\uACF3\uC73C\uB85C
      \uBE68\uC544\uB4E4\uC778 \uB4A4\n\uD55C\uAEBC\uBC88\uC5D0 \uD130\uB728\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636448
    m_Localized: "\uC21C\uAC04\uD3ED\uD0C4"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636449
    m_Localized: "5\uCD08 \uB3D9\uC548 \uB358\uC9C0\uB294 \uD3ED\uD0C4\uC774 \uB545\uC5D0
      \uB2FF\uC790\uB9C8\uC790 \uD130\uC9C0\uACE0,\n\uACF5\uACA9\uC18D\uB3C4\uC640
      \uC0AC\uAC70\uB9AC\uAC00 \uD06C\uAC8C \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636450
    m_Localized: "\uB2E4\uBC1C\uD3ED\uD0C4"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636451
    m_Localized: "\uD3ED\uD0C4 10\uAC1C\uB97C \uC0AC\uBC29\uC73C\uB85C \uBFCC\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636452
    m_Localized: "\uC2A4\uD0AC \uC560\uD638\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636453
    m_Localized: "\uC2A4\uD0AC\uB85C \uC801 100\uB9C8\uB9AC \uCC98\uCE58\uD558\uAE30
      (\uB204\uC801)"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636454
    m_Localized: "\uD5DB\uC190\uC9C8"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636455
    m_Localized: "\uC2A4\uD0AC\uC744 \uC368\uC11C \uC544\uBB34\uB3C4 \uBABB \uC7A1\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636456
    m_Localized: "\uC800\uC8FC\uBC1B\uC740 \uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636457
    m_Localized: "\uC800\uC8FC 9\uAC1C\uB97C \uBAA8\uB450 \uD574\uAE08\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636458
    m_Localized: "\uC218\uC9D1\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636459
    m_Localized: "\uBAA8\uB4E0 \uBB34\uAE30, \uC2A4\uD0AC, \uC2A4\uD0AC \uAC15\uD654,
      \uC544\uD2F0\uD329\uD2B8 \uD574\uAE08\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636460
    m_Localized: "\uBD89\uC740 \uC0AC\uB0E5"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636461
    m_Localized: "\uAD11\uD3ED\uD574\uC9C4 \uBD89\uC740 \uC801 50\uB9C8\uB9AC \uCC98\uCE58\uD558\uAE30
      (\uB204\uC801)"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636462
    m_Localized: "\uBE14\uB799\uD640 \uC18C\uC6A9\uB3CC\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636463
    m_Localized: "\uBE14\uB799\uD640 \uD55C \uBC88\uC73C\uB85C 10\uB9C8\uB9AC \uB3D9\uC2DC\uC5D0
      \uCC98\uCE58\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636464
    m_Localized: "\uC0AC\uAC74\uC758 \uC9C0\uD3C9\uC120"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636465
    m_Localized: "\uBE14\uB799\uD640\uB85C \uBCF4\uC2A4\uC5D0\uAC8C \uB9C8\uC9C0\uB9C9
      \uD55C \uBC29 \uB123\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636466
    m_Localized: "\uBC15\uCE58\uAE30 \uC655"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636467
    m_Localized: "\uB300\uC2DC \uBC15\uCE58\uAE30\uB85C \uBCF4\uC2A4\uC5D0\uAC8C
      \uB9C8\uC9C0\uB9C9 \uD55C \uBC29 \uB123\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636468
    m_Localized: "\uC778\uAE30 \uD3ED\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636469
    m_Localized: "\uB9F5 \uC548\uC5D0 \uC801 40\uB9C8\uB9AC\uAC00 \uB3D9\uC2DC\uC5D0
      \uC788\uAC8C \uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636470
    m_Localized: "\uD558\uB298\uC758 \uB3C4\uC6C0"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636471
    m_Localized: "\uC6B4\uC11D\uACFC \uB099\uB8B0\uB85C \uC801 50\uB9C8\uB9AC \uCC98\uCE58\uD558\uAE30
      (\uB204\uC801)"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636472
    m_Localized: "\uC544\uC2AC\uC544\uC2AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636473
    m_Localized: "\uB300\uC2DC\uB85C \uC801 \uACF5\uACA9\uC744 \uB204\uC801 3\uBC88
      \uD53C\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636474
    m_Localized: "\uC791\uACE0 \uC18C\uC911\uD55C"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636475
    m_Localized: "\uD55C \uB300 \uB0A8\uC740 \uAF2C\uAF2C\uB9C8 \uACE8\uB818\uC744
      15\uCD08 \uB3D9\uC548 \uC0B4\uB824 \uB450\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636476
