    m_Metadata:
      m_Items: []
  - m_Id: 6819880636473
    m_Localized: Dodge enemy attacks with a dash 3 times (total)
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636474
    m_Localized: Small and Precious
