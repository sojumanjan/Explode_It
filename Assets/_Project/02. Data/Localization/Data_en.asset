  m_TableData:
  - m_Id: 6819830304768
    m_Localized: Onslaught
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636416
    m_Localized: 'Enemies swarm in 25% faster,

      and every enemy type appears
      from the start.'
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636417
    m_Localized: Chain Blast
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636418
    m_Localized: Enemies explode where they die.
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636419
    m_Localized: Meteor
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636420
    m_Localized: Every 5 seconds, a meteor falls near you.
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636421
    m_Localized: Berserk
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636422
    m_Localized: 'Now and then a red-hot enemy

      charges at you very fast.'
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636423
    m_Localized: Lightning
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636424
    m_Localized: Every 18 seconds, lightning strikes a huge area.
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636425
    m_Localized: Ambush
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636426
    m_Localized: Enemies have a 50% chance to spawn near you.
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636427
    m_Localized: Trap
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636428
    m_Localized: 'Every 10 seconds, 3 traps appear near you.

      Stepping on one
      hurts, but bombs can destroy them.'
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636429
    m_Localized: One Hit
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636430
    m_Localized: 'You have only 1 heart.

      Even the Pendant won''t help.'
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636431
    m_Localized: Dust Storm
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636432
    m_Localized: 'Dust storms blow across the map.

      You move 30% slower inside
      them, and they keep moving.'
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636433
    m_Localized: 'To one who bears every curse,

      He comes in person.'
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636434
    m_Localized: Archer
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636435
    m_Localized: Fire Mage
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636436
    m_Localized: Drill Miner
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636437
    m_Localized: Beast
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636438
    m_Localized: Awakened King
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636439
    m_Localized: Maybe I should strike when that crown falls...
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636440
    m_Localized: Charger
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636441
    m_Localized: Golem
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636442
    m_Localized: Mantis
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636443
    m_Localized: Shield Bearer
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636444
    m_Localized: Sniper
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636445
    m_Localized: Warrior
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636446
    m_Localized: Black Hole
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636447
    m_Localized: 'Pulls enemies in a wide area into one spot,

      then blows them
      all up at once.'
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636448
    m_Localized: Instant Bomb
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636449
    m_Localized: 'For 5 seconds, your bombs explode the moment they land,

      and
      your throw speed and range greatly increase.'
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636450
    m_Localized: Scatter Bomb
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636451
    m_Localized: Scatters 10 bombs in every direction.
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636452
    m_Localized: Skill Lover
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636453
    m_Localized: Defeat 100 enemies with skills (total)
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636454
    m_Localized: Whiff
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636455
    m_Localized: Use a skill and defeat no one
    m_Metadata:
      m_Items: []
