    m_Metadata:
      m_Items: []
  - m_Id: 6819880636461
    m_Localized: Defeat 50 berserk red enemies (total)
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636462
    m_Localized: Black Hole Vortex
    m_Metadata:
      m_Items: []
  - m_Id: 6819880636463
