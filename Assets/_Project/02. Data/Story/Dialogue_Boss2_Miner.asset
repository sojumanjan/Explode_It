  _lines:
  - _speaker: 0
    _mood: 3
    _text: "\uB9C8\uBC95\uC0AC \uB140\uC11D... \uB3C8\uB9CC \uBC1B\uACE0 \uADF8\uB0E5
      \uB4DC\uB7EC\uB204\uC6E0\uC5B4..."
    _hold: 1.2
  - _speaker: 0
    _mood: 1
    _text: "\uC774\uBC88\uC5D4 \uB545\uC18D\uC5D0\uC11C \uB05D\uB0B8\uB2E4. \uAD11\uBD80,
      \uB098\uC640\uB77C!"
    _hold: 1.2
  - _speaker: 1
    _mood: 0
    _text: "\uB2E4\uC774\uB108\uB9C8\uC774\uD2B8 \uAC12\uC740 \uB530\uB85C\uC785\uB2C8\uB2E4\uC694."
    _hold: 1
  - _speaker: 0
    _mood: 4
    _text: "...\uC694\uC998 \uC6A9\uBCD1\uB4E4\uC740 \uB2E4 \uC65C \uC774\uB798."
    _hold: 1
  - _speaker: 0
    _mood: 5
    _text: "\uB0A0\uB824 \uBC84\uB824!"
    _hold: 0.8
