  _lines:
  - _speaker: 0
    _mood: 0
    _text: "\uC624~ \uCCAD\uAD6C\uC11C \uBC1B\uACE0\n\uC9C4\uC9DC \uC654\uAD6C\uB098?"
    _spawnBoss: 0
    _startEntrance: 0
    _bossSprite: {fileID: 0}
    _revertToKing: 0
    _bgm: {fileID: 0}
    _startAction: 0
    _endAction: 0
  - _speaker: 2
    _mood: 0
    _text: "\uAC1A\uC744 \uB3C8\uC740 \uC5C6\uACE0\uC694..\n\uADF8\uB0E5 \uC2F8\uC6B0\uB7EC
      \uC654\uC5B4\uC694.."
    _spawnBoss: 0
    _startEntrance: 0
    _bossSprite: {fileID: 0}
    _revertToKing: 0
    _bgm: {fileID: 0}
    _startAction: 0
    _endAction: 0
  - _speaker: 0
    _mood: 1
    _text: "\uC800\uC8FC\uB97C \uC804\uBD80 \uC9CA\uC5B4\uC9C0\uACE0?"
    _spawnBoss: 0
    _startEntrance: 0
    _bossSprite: {fileID: 0}
    _revertToKing: 0
    _bgm: {fileID: 0}
    _startAction: 0
    _endAction: 0
  - _speaker: 0
    _mood: 2
    _text: "\uD06C\uD558\uD558! \uADF8 \uBCA0\uC9F1 \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uAD6C\uB098!!"
    _spawnBoss: 0
    _startEntrance: 0
    _bossSprite: {fileID: 0}
    _revertToKing: 0
    _bgm: {fileID: 0}
    _startAction: 0
    _endAction: 0
  - _speaker: 2
    _mood: 0
    _text: "\uC81C\uAC00 \uC774\uAE30\uBA74\n\uBE5A\uC740 \uC5C6\uB358 \uAC78\uB85C
      \uD574 \uC8FC\uC138\uC694."
    _spawnBoss: 0
    _startEntrance: 0
    _bossSprite: {fileID: 0}
    _revertToKing: 0
    _bgm: {fileID: 0}
    _startAction: 0
    _endAction: 0
  - _speaker: 0
    _mood: 5
    _text: "\uC88B\uB2E4! \uB300\uC2E0 \uC9C0\uBA74\n\uD3C9\uC0DD \uC9D0\uC758 \uC0AC\uB0E5\uAFBC\uC774\uB2E4~"
    _spawnBoss: 0
    _startEntrance: 0
    _bossSprite: {fileID: 0}
    _revertToKing: 0
    _bgm: {fileID: 0}
    _startAction: 0
    _endAction: 0
  - _speaker: 1
    _mood: 8
    _text: "\uC774\uBC88\uC5D4 \uC9D0\uB3C4 \uBD10\uC8FC\uC9C0 \uC54A\uACA0\uB2E4!"
    _spawnBoss: 1
    _startEntrance: 1
    _bossSprite: {fileID: 0}
    _revertToKing: 0
    _bgm: {fileID: 0}
    _startAction: 0
    _endAction: 0
