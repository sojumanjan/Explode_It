  _lines:
  - _speaker: 0
    _mood: 4
    _text: "\uD760\uD760\uD760~~"
    _callsSoldiers: 0
    _popsGoblinBefore: 0
  - _speaker: 0
    _mood: 4
    _text: "\uC694\uC998\uB530\uB77C \uB108\uBB34 \uB530\uBD84\uD574\uC11C \uC88B\uB124~~"
    _callsSoldiers: 0
    _popsGoblinBefore: 0
  - _speaker: 0
    _mood: 6
    _text: "\uC5B4\uC5B4\u2026!!!"
    _callsSoldiers: 0
    _popsGoblinBefore: 1
  - _speaker: 0
    _mood: 6
    _text: "\u3141...\uBB34..\uBB50\uC57C!!! \uACE0\uBE14\uB9B0\uC774\uB2E4!!!"
    _callsSoldiers: 0
    _popsGoblinBefore: 0
  - _speaker: 0
    _mood: 1
    _text: "\uAC11\uC790\uAE30 \uBAAC\uC2A4\uD130\uAC00 \uC65C \uC5EC\uAE30\uC5D0\u2026!!!"
    _callsSoldiers: 0
    _popsGoblinBefore: 0
  - _speaker: 2
    _mood: 0
    _text: "\uC5EC, \uC5EC\uAE34 \uC5B4\uB514\uC57C?!"
    _callsSoldiers: 0
    _popsGoblinBefore: 0
  - _speaker: 0
    _mood: 6
    _text: "\uBCD1\uC0AC\uB4E4!! \uC800 \uB140\uC11D\uC744 \uC7A1\uC544\uB77C!!"
    _callsSoldiers: 1
    _popsGoblinBefore: 0
  - _speaker: 2
    _mood: 6
    _text: "\uC608?? \u3147..\uC544\uB2C8 \uC7A0\uAE50\uB9CC\uC694...!!"
    _callsSoldiers: 0
    _popsGoblinBefore: 0
  - _speaker: 0
    _mood: 6
    _text: "\uBE68\uB9AC \uC548\uC7A1\uACE0 \uBB50\uD574!!\n\uC6D4\uAE09 \uBC1B\uAE30
      \uC2EB\uC5B4??"
    _callsSoldiers: 1
    _popsGoblinBefore: 0
  - _speaker: 2
    _mood: 6
    _text: "\uC73C\uC544\uC544\uC544\u314F\u314F!!!"
    _callsSoldiers: 0
    _popsGoblinBefore: 0
